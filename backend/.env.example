CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development

# ── Email Notifications ────────────────────────────────────────────────────
# All enquiry leads are delivered to ADMIN_EMAIL (the driving school owner).
ADMIN_EMAIL=naveenkanakaraj2023@gmail.com

# Gmail SMTP setup
#  1. Enable 2-Step Verification on your Google account.
#  2. Go to https://myaccount.google.com/apppasswords
#  3. Create an App Password for "Mail" → copy the 16-char code.
#  4. Paste it as SMTP_PASSWORD below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=naveenkanakaraj2023@gmail.com
SMTP_PASSWORD=your-16-char-app-password-here
SMTP_FROM_EMAIL=naveenkanakaraj2023@gmail.com
SMTP_USE_TLS=True
